<mujoco model="quadcopter">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" density="1.225" viscosity="1.8e-5" integrator="RK4"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.2"/>
    <material name="body_mat" rgba="0.15 0.15 0.2 1"/>
    <material name="arm_mat" rgba="0.6 0.6 0.6 1"/>
    <material name="cw_mat" rgba="0.85 0.15 0.15 0.9"/>
    <material name="ccw_mat" rgba="0.15 0.45 0.85 0.9"/>
  </asset>

  <default>
    <default class="arm">
      <geom type="capsule" size="0.003" material="arm_mat" mass="0.002"/>
    </default>
    <default class="rotor">
      <geom type="cylinder" size="0.0235 0.0014" mass="0.0005" contype="0" conaffinity="0"/>
    </default>
    <default class="motor">
      <geom type="cylinder" size="0.003 0.013" mass="0.001" contype="0" conaffinity="0"/>
      <motor ctrlrange="0 1.5" ctrllimited="true"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="15 15 0.1" material="grid"/>

    <body name="quad" pos="0 0 1">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.029" diaginertia="1.4e-5 1.4e-5 2.17e-5"/>

      <geom name="core" type="box" size="0.015 0.015 0.01" material="body_mat"/>
      <site name="imu" pos="0 0 0" size="0.005"/>
      <camera name="chase" pos="-0.8 0 0.4" xyaxes="0 -1 0 0.4 0 1" mode="track"/>

      <!-- arms: layout, motor 1 front-right (CCW), 2 back-left (CCW), 3 front-left (CW), 4 back-right (CW) -->
      <geom class="arm" fromto="0.015 0.015 -0.005  0.028325 0.028325 -0.005"/>
      <geom class="arm" fromto="-0.015 -0.015 -0.005 -0.028325 -0.028325 -0.005"/>
      <geom class="arm" fromto="-0.015 0.015 -0.005 -0.028325  0.028325 -0.005"/>
      <geom class="arm" fromto="0.015 -0.015 -0.005  0.028325 -0.028325 -0.005"/>

      <site name="motor1" pos="0.028325  0.028325 0.005" size="0.003"/>
      <site name="motor2" pos="-0.028325 -0.028325 0.005" size="0.003"/>
      <site name="motor3" pos="-0.028325 0.028325 0.005" size="0.003"/>
      <site name="motor4" pos="0.028325 -0.028325 0.005" size="0.003"/>

      <geom class="rotor" pos="0.028325 0.028325 0.02" material="ccw_mat"/>
      <geom class="rotor" pos="-0.028325 -0.028325 0.02" material="ccw_mat"/>
      <geom class="rotor" pos="-0.028325 0.028325 0.02" material="cw_mat"/>
      <geom class="rotor" pos="0.028325 -0.028325 0.02" material="cw_mat"/>

      <geom class="motor" pos="0.028325 0.028325 0.008" material="body_mat"/>
      <geom class="motor" pos="-0.028325 -0.028325 0.008" material="body_mat"/>
      <geom class="motor" pos="-0.028325 0.028325 0.008" material="body_mat"/>
      <geom class="motor" pos="0.028325 -0.028325 0.008" material="body_mat"/>
    </body>
  </worldbody>

  <actuator>
    <!-- gear = [Fx Fy Fz Tx Ty Tz] in the site frame; Fz = thrust, Tz = reaction yaw torque -->
    <motor class="motor" name="thrust1" site="motor1" gear="0 0 1 0 0  0.07"/>
    <motor class="motor" name="thrust2" site="motor2" gear="0 0 1 0 0  0.07"/>
    <motor class="motor" name="thrust3" site="motor3" gear="0 0 1 0 0 -0.07"/>
    <motor class="motor" name="thrust4" site="motor4" gear="0 0 1 0 0 -0.07"/>
  </actuator>

  <sensor>
    <gyro name="gyro" site="imu"/>
    <accelerometer name="accel" site="imu"/>
    <framequat name="orientation" objtype="site" objname="imu"/>
    <framepos name="position" objtype="site" objname="imu"/>
    <framelinvel name="velocity" objtype="site" objname="imu"/>
  </sensor>
</mujoco>